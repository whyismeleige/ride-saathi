OLA_MAPS_API_KEY=
PORT=8000
BIND_HOST=127.0.0.1
OLA_MAPS_BASE_URL=https://api.olamaps.io
OLA_MAPS_TIMEOUT_SECONDS=8
MAPS_RATE_LIMIT_PER_MINUTE=60
MAPS_RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY_HEADERS=false

# PostgreSQL: set this before using persistence or running Alembic.
# postgresql:// URLs are also accepted and normalized to asyncpg.
DATABASE_URL=
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_NULL_POOL=false

# Operational logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

ENVIRONMENT=production

# Optional online neural speech. Keep the key on the backend only.
# Region must match your Azure Speech resource (for example centralindia).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
TTS_VOICE_TE=te-IN-ShrutiNeural
TTS_TIMEOUT_SECONDS=8
TTS_RATE_LIMIT_PER_MINUTE=30
TTS_GLOBAL_RATE_LIMIT_PER_MINUTE=120

# Azure STT uses the Speech resource endpoint shown in the Azure portal.
AZURE_SPEECH_ENDPOINT=
# Azure OpenAI resource root, key, and YOUR structured-output model deployment name.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
STT_TIMEOUT_SECONDS=10
LLM_TIMEOUT_SECONDS=8
