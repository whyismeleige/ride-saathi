# Ola Maps API key. This is the ONLY place the credential exists. Never commit
# a real value; never ship it inside the Android APK.
OLA_MAPS_API_KEY=

# Runtime mode: development | production
ENVIRONMENT=development

# Compose host port; the container always listens on 8000.
# Direct Docker runs also use PORT as the container listening port.
PORT=8000

# Use 0.0.0.0 to allow a physical Android device on your LAN to connect.
BIND_HOST=127.0.0.1
