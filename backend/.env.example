# Ola Maps API key. This is the ONLY place the credential exists. Never commit
# a real value; never ship it inside the Android APK.
OLA_MAPS_API_KEY=

# Runtime mode: development | testing | production
ENVIRONMENT=development

# Compose host port; the container always listens on 8000.
# Direct Docker runs also use PORT as the container listening port.
PORT=8000

# Use 0.0.0.0 to allow a physical Android device on your LAN to connect.
BIND_HOST=127.0.0.1

# PostgreSQL: set this before using persistence or running Alembic.
# postgresql:// URLs are also accepted and normalized to asyncpg.
DATABASE_URL=
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_NULL_POOL=false

# Local Docker PostgreSQL host port. Host-run app uses this port in DATABASE_URL.
POSTGRES_PORT=5432
# Optional URL override for the app INSIDE Compose (default host is postgres).
# COMPOSE_DATABASE_URL=

# Operational logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

OLA_MAPS_BASE_URL=https://api.olamaps.io
OLA_MAPS_TIMEOUT_SECONDS=8
